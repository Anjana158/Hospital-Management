generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url = env("DATABASE_URL")
}

enum UserStatus {
    ACTIVE
    INACTIVE
    LOCKED
}

enum Gender {
    MALE
    FEMALE
    TRANSGENDER
}

enum VisitType {
    NEW
    REVISIT
}

enum VisitStatus {
    REGISTERED
    WAITING
    IN_CONSULTATION
    COMPLETED
    CANCELLED
    NO_SHOW
}

enum RecordStatus {
    ACTIVE
    INACTIVE
}

enum SchemeDiscountType {
  NONE
  PERCENTAGE
  FIXED
}

model Role {
    id          Int         @id @default(autoincrement())
    name        String      @unique
    description String? 

    createdAt   DateTime    @default(now())
    updatedAt   DateTime    @updatedAt

    users   User[]

    @@map("roles")  
}


model User {
    id              Int         @id @default(autoincrement())

    employeeId      String      @unique
    fullName        String      
    username        String      @unique
    password        String

    status          UserStatus  @default(ACTIVE)

    lastLogin       DateTime?

    failedAttempts  Int         @default(0)

    createdBy       Int?

    createdAt       DateTime    @default(now())
    updatedAt       DateTime    @updatedAt

    roleId          Int         
    role            Role        @relation(fields: [roleId], references: [id])

    createdPatients Patient[]       @relation("PatientCreatedBy")
    createdVisits   PatientVisit[]  @relation("VisitCreatedBy")

    @@map("users") 
}

model PatientScheme {
  id             Int                 @id @default(autoincrement())
  code           String              @unique
  name           String              @unique
  discountType   SchemeDiscountType  @default(NONE)
  discountValue  Decimal             @default(0) @db.Decimal(10, 2)
  status         RecordStatus        @default(ACTIVE)

  patients       Patient[]

  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
}

model Department {
    id         Int            @id @default(autoincrement())
    code       String         @unique
    name       String         @unique
    status     RecordStatus   @default(ACTIVE)

    doctors    Doctor[]
    visits     PatientVisit[]

    createdAt  DateTime       @default(now())
    updatedAt  DateTime       @updatedAt
}

model Doctor {
    id             Int            @id @default(autoincrement())
    employeeCode   String?        @unique
    fullName       String
    specialization String?
    status         RecordStatus   @default(ACTIVE)

    departmentId   Int
    department     Department     @relation(fields: [departmentId], references: [id], onDelete: Restrict)

    visits         PatientVisit[]

    createdAt      DateTime       @default(now())
    updatedAt      DateTime       @updatedAt

    @@index([departmentId])
}

model Patient {
    id             Int             @id @default(autoincrement())
    uhid           String          @unique

    firstName      String
    middleName     String?
    lastName       String?
    dateOfBirth    DateTime?
    age            Int
    gender         Gender      

    phone          String
    alternatePhone String?
    email          String?

    addressLine1   String?
    addressLine2   String?
    city           String?
    district       String?
    state          String?
    postalCode     String?
    country        String?

    status         RecordStatus    @default(ACTIVE)

    schemeId       Int?
    scheme         PatientScheme? @relation(fields: [schemeId], references: [id], onDelete: Restrict)

    createdBy      Int
    createdByUser  User            @relation("PatientCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)

    visits         PatientVisit[]

    createdAt      DateTime        @default(now())
    updatedAt      DateTime        @updatedAt
    archivedAt     DateTime?

    @@index([lastName, firstName])
    @@index([phone])
    @@index([schemeId])
    @@index([createdAt])
}

model PatientVisit {
    id             Int          @id @default(autoincrement())
    visitNumber    String       @unique
    tokenNumber    Int?
    visitDate      DateTime     @default(now())

    visitType      VisitType
    revisitCount   Int          @default(0)
    status         VisitStatus  @default(REGISTERED)

    patientId      Int
    patient        Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)

    departmentId   Int
    department     Department   @relation(fields: [departmentId], references: [id], onDelete: Restrict)

    doctorId       Int
    doctor         Doctor       @relation(fields: [doctorId], references: [id], onDelete: Restrict)

    createdBy      Int
    createdByUser  User         @relation("VisitCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)

    genderAtVisit  Gender?

    opFee          Decimal      @default(10) @db.Decimal(10, 2)
    discountAmount Decimal      @default(0) @db.Decimal(10, 2)
    finalFee       Decimal      @default(0) @db.Decimal(10, 2)

    createdAt      DateTime     @default(now())
    updatedAt      DateTime     @updatedAt
    cancelledAt    DateTime?
    completedAt    DateTime?

    @@index([visitDate])
    @@index([patientId, visitDate])
    @@index([patientId, doctorId, visitDate])
    @@index([departmentId, visitDate])
    @@index([doctorId, visitDate])
    @@index([createdBy, visitDate])
    @@index([visitDate, tokenNumber])
    @@index([patientId, doctorId, revisitCount])
}

model DailyTokenCounter {
    id          Int      @id @default(autoincrement())
    tokenDate   DateTime @unique
    nextToken   Int      @default(1)

    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    @@index([tokenDate])
}